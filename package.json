{
  "name": "daily-catch-up",
  "version": "1.3.0-preview.1",
  "description": "Catch up on unfinished todos from your previous daily note: roll them over to today, park them in a backlog, or cancel them.",
  "main": "main.js",
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rollup -c --environment BUILD:production",
    "test": "vitest",
    "format": "prettier --write ."
  },
  "cspell": {
    "words": [
      "todos"
    ]
  },
  "keywords": [],
  "author": "Lyndon Washington",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^15.1.0",
    "@rollup/plugin-node-resolve": "^9.0.0",
    "obsidian": "https://github.com/obsidianmd/obsidian-api/tarball/master",
    "prettier": "^2.8.1",
    "rollup": "^2.32.1",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "obsidian-daily-notes-interface": "^0.9.2"
  }
}
