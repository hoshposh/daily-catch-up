{
  "name": "daily-catch-up",
  "version": "1.6.0-preview.1",
  "description": "Catch up on unfinished todos from your recent daily notes and an inbox note: roll them over to today, park them in a backlog, or cancel them.",
  "main": "main.js",
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rollup -c --environment BUILD:production",
    "test": "vitest",
    "format": "prettier --write .",
    "test:e2e": "vitest run --config vitest.e2e.config.js",
    "demo": "vitest run --config vitest.demo.config.js"
  },
  "cspell": {
    "words": [
      "todos"
    ]
  },
  "keywords": [],
  "author": "Lyndon Washington",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^15.1.0",
    "@rollup/plugin-node-resolve": "^9.0.0",
    "moment": "2.31.0",
    "obsidian": "1.14.4",
    "prettier": "^2.8.1",
    "rollup": "^2.32.1",
    "vitest": "^3.1.2"
  }
}
